APP_NAME="Industrial Knowledge Intelligence Platform API"
APP_VERSION="1.0.0"
DEBUG=False

# Server / Uvicorn
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_WORKERS=1

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Security
SECRET_KEY="your-super-secret-jwt-key-here-change-in-production"

# Database
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/ikip"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False

UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_MIME_TYPES='["application/pdf","text/plain","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]'
MAX_FILENAME_LENGTH=255
UPLOAD_CHUNK_SIZE=65536

