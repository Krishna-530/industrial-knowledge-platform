# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Backend Settings
APP_NAME="Industrial Knowledge Intelligence Platform"
APP_ENV=development  # development, testing, staging, production
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=replace_with_a_secure_random_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# PostgreSQL & pgvector Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=industrial_brain
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/industrial_brain

# Neo4j Graph Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Artificial Intelligence & LLMs
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=llama-3.3-70b-versatile

# Document Storage Settings
STORAGE_PROVIDER=local  # local, s3
LOCAL_STORAGE_PATH=./storage/documents

# Logging & Observability
LOG_LEVEL=INFO
ENABLE_TELEMETRY=false
